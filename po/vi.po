#: src/vte.cc:8497
msgid "WARNING"
msgstr "CẢNH BÁO"

#: src/vte.cc:8499
msgid "GnuTLS not enabled; data will be written to disk unencrypted!"
msgstr ""
"GnuTLS không được bật; dữ liệu sẽ được ghi vào ổ đĩa mà không được mã hóa!"

#: src/spawn.cc:133
#, c-format
msgid "Failed to set pipe nonblocking: %s"
msgstr "Không thể thiết lập pipe nonblocking: %s"

#: src/spawn.cc:178
#, c-format
msgid "poll error: %s"
msgstr "Lỗi thăm dò: %s"

#: src/spawn.cc:185
msgid "Operation timed out"
msgstr "Đã hết thời gian chờ thao tác"

#: src/spawn.cc:195
msgid "Operation was cancelled"
msgstr "Thao tác đã bị hủy"

#: src/spawn.cc:213
#, c-format
msgid "Failed to read from child pipe (%s)"
msgstr "Không thể đọc dữ liệu từ pipe con (%s)"

#: src/spawn.cc:664
#, c-format
msgid "Failed to change to directory “%s”: %s"
msgstr "Không thể chuyển đến thư mục “%s”: %s"

